{
  "$schema": "https://schemas.cuvva.com/design-tokens/v1",
  "name": "Claude Design",
  "version": "1.0.0",
  "description": "Brand tokens for Claude Design — sports-sector visual studio. Para uso por Claude Design, Figma plugins, build pipelines.",

  "color": {
    "brand": {
      "blue":  { "value": "#1C40E0", "description": "Primary. Royal/electric. 50-60% visual weight." },
      "navy":  { "value": "#0A1742", "description": "Deep blue background. Used 5-10%." },
      "black": { "value": "#000000", "description": "Editorial backgrounds and remarques. Used 10-15%." },
      "gray":  { "value": "#E8E9EC", "description": "Light neutral surface. 25-30%." },
      "white": { "value": "#FFFFFF", "description": "Pure white, used only on dark surfaces." }
    },
    "semantic": {
      "bg":            { "value": "{color.brand.gray}" },
      "bg-deep":       { "value": "{color.brand.navy}" },
      "bg-strong":     { "value": "{color.brand.black}" },
      "text":          { "value": "{color.brand.black}" },
      "text-onDark":   { "value": "{color.brand.gray}" },
      "link":          { "value": "{color.brand.blue}" },
      "highlight":     { "value": "{color.brand.blue}" }
    }
  },

  "typography": {
    "family": {
      "display": {
        "value": "Big Shoulders, Impact, Bebas Neue, Arial Black, sans-serif",
        "description": "Condensed display. Always uppercase. Titulares y números grandes."
      },
      "body": {
        "value": "Instrument Sans, Inter, Helvetica Neue, system-ui, sans-serif",
        "description": "Body and lede."
      },
      "mono": {
        "value": "DM Mono, JetBrains Mono, SF Mono, Menlo, monospace",
        "description": "Meta, etiquetas técnicas, datos, marcadores."
      }
    },
    "weight": {
      "regular": { "value": 400 },
      "medium":  { "value": 500 },
      "bold":    { "value": 700 },
      "black":   { "value": 900 }
    },
    "size": {
      "mega":    { "value": "clamp(64px, 12vw, 196px)" },
      "display": { "value": "clamp(48px, 7vw, 110px)" },
      "h1":      { "value": "clamp(40px, 5.5vw, 80px)" },
      "h2":      { "value": "clamp(32px, 4vw, 56px)" },
      "h3":      { "value": "clamp(24px, 2.5vw, 36px)" },
      "h4":      { "value": "20px" },
      "lede":    { "value": "20px" },
      "body":    { "value": "16px" },
      "small":   { "value": "14px" },
      "meta":    { "value": "11px" }
    },
    "lineHeight": {
      "tight":  { "value": 0.88 },
      "snug":   { "value": 1.0 },
      "normal": { "value": 1.5 },
      "loose":  { "value": 1.7 }
    },
    "letterSpacing": {
      "display": { "value": "-0.015em" },
      "meta":    { "value": "0.2em" },
      "tag":     { "value": "0.04em" }
    }
  },

  "space": {
    "1":  { "value": "4px"  },
    "2":  { "value": "8px"  },
    "3":  { "value": "12px" },
    "4":  { "value": "16px" },
    "5":  { "value": "24px" },
    "6":  { "value": "32px" },
    "7":  { "value": "48px" },
    "8":  { "value": "64px" },
    "9":  { "value": "96px" },
    "10": { "value": "128px" }
  },

  "radius": {
    "0":    { "value": "0",     "description": "Default. Hard edges, deportivo." },
    "1":    { "value": "2px",   "description": "Cards." },
    "pill": { "value": "999px", "description": "Solo en botones de CTA." }
  },

  "motion": {
    "ease":     { "value": "cubic-bezier(0.2, 0.8, 0.2, 1)" },
    "duration": {
      "fast": { "value": "180ms" },
      "base": { "value": "280ms" },
      "slow": { "value": "550ms" }
    }
  },

  "container": {
    "default": { "value": "1320px" },
    "narrow":  { "value": "880px"  },
    "gutter":  { "value": "32px"   }
  },

  "instagram": {
    "format": {
      "square":   { "value": "1080x1080", "description": "Cuadrado clásico" },
      "portrait": { "value": "1080x1350", "description": "4:5, ocupa más feed" },
      "story":    { "value": "1080x1920", "description": "Stories y Reels" }
    },
    "safeZone": { "value": "120px", "description": "Margen mínimo para que IG no recorte." }
  }
}
